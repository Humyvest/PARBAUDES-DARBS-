$apturetie = Get-Service |
    Where-Object { $_.Status -eq "Stopped" } |
    Sort-Object Name |
    Select-Object Name, Status

$apturetie | Export-Csv -Path "apturetie.csv" -NoTypeInformation -Encoding utf8  

#  1.Skripts atrod visus apturētos servisus (Stopped) 
2. saglabā tos CSV failā izmantojot pareizo kodējumu 
3.noņem lieko datu tipa informāciju
